---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import CommentSection from '../../components/CommentSection.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content } = await render(post);
const apiBaseUrl = import.meta.env.PUBLIC_BLOG_API_URL || 'https://blog-api.apidevyanshsite.workers.dev';
---

<BaseLayout 
	title={post.data.title} 
	description={post.data.description} 
	image={post.data.heroImage}
	pubDate={post.data.pubDate}
	updatedDate={post.data.updatedDate}
>
	<article class="post-article">
		{post.data.heroImage && (
			<div class="hero-image-wrap">
				<img src={post.data.heroImage} alt={post.data.title} class="hero-image" />
			</div>
		)}
		<header class="post-header">
			<div class="post-meta">
				<time datetime={post.data.pubDate.toISOString()}>
					{
						post.data.pubDate.toLocaleDateString('en-us', {
							year: 'numeric',
							month: 'long',
							day: 'numeric',
						})
					}
				</time>
				{
					post.data.updatedDate && (
						<span class="last-updated-on">
							• Last updated on <time datetime={post.data.updatedDate.toISOString()}>
								{post.data.updatedDate.toLocaleDateString('en-us', {
									year: 'numeric',
									month: 'long',
									day: 'numeric',
								})}
							</time>
						</span>
					)
				}
			</div>
			<h1>{post.data.title}</h1>
			{post.data.description && <p class="post-lead">{post.data.description}</p>}
		</header>
		<hr class="post-divider" />
		<div class="content">
			<Content />
		</div>
		<CommentSection postSlug={post.id} apiBaseUrl={apiBaseUrl} />
	</article>
</BaseLayout>

<style>
  .post-article {
    max-width: 800px;
    margin: 0 auto;
  }
  .breadcrumb {
    margin-bottom: 1.5rem;
  }
  .breadcrumb a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.95rem;
    color: var(--accent-color);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .breadcrumb a:hover {
    transform: translateX(-3px);
  }
  .hero-image-wrap {
    width: 100%;
    border-radius: 14px;
    overflow: hidden;
    margin-bottom: 2rem;
    border: 1px solid var(--border-color);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
  }
  .hero-image {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }
  .post-header {
    margin-bottom: 1.5rem;
  }
  .post-header h1 {
    font-size: clamp(2rem, 4vw, 2.85rem);
    line-height: 1.2;
    margin-bottom: 0.75rem;
  }
  .post-lead {
    font-size: 1.15rem;
    color: var(--text-color);
    opacity: 0.85;
    line-height: 1.6;
  }
  .post-divider {
    border: none;
    height: 1px;
    background: var(--border-color);
    margin: 2rem 0;
  }
  .content {
    width: 100%;
    font-size: 1.05rem;
    line-height: 1.8;
  }
  article :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 12px;
    display: block;
    margin: 2rem auto;
    border: 1px solid var(--border-color);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
  }
  article :global(figure) {
    margin: 2rem 0;
    text-align: center;
  }
  article :global(figcaption) {
    font-size: 0.875rem;
    color: var(--footer-text);
    margin-top: 0.5rem;
    font-style: italic;
  }
</style>
